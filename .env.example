# Copy to `.env` and fill in. NEVER commit `.env`. Secrets stay server-side only.
# This file is TRACKED. Every value here must stay a blank placeholder.

# --- Ingestion ---
# Store scrapers (Play/App Store) need NO key.
APIFY_API_KEY=              # Reddit via Apify. Unset = Reddit falls back to RSS (not the
                            # delivery path for this brief — see pipeline/sources.py).
YOUTUBE_API_KEY=            # YouTube Data API v3. THE ONLY VARIABLE INGEST REQUIRES.
                            # Default quota 10,000 units/day: search.list costs 100/call,
                            # commentThreads.list costs 1.

# --- Embeddings + LLM ---
# WHICH MODELS IS AN OPEN DECISION — see decisions.md.
OPENROUTER_API_KEY=
GROQ_API_KEY=               # For Qwen LLM via Groq
GEMINI_API_KEY=             # For Google's free embedding (text-embedding-004)

# --- Optional overrides (sensible defaults live in pipeline/config.py) ---
# EMBEDDING_MODEL=                    # OPEN DECISION — see decisions.md
# LLM_MODEL=                          # OPEN DECISION — see decisions.md
# REDDIT_TRANSPORT=apify              # apify | rss
# APIFY_REDDIT_ACTOR=trudax/reddit-scraper

# --- Local development ONLY. Never set in a deployed environment. ---
# Bypasses the STEP 7 taxonomy corpus-fingerprint boot gate. A bypassed gate means
# cluster assignments may be meaningless.
# ALLOW_UNVERIFIED_TAXONOMY=i-know-this-is-wrong
